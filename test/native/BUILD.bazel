load("@forge//bazel:cc.bzl", "forge_cc_binary", "forge_cc_test")

# Checks that GoogleTest itself works.
forge_cc_test(
    name = "ut-simple",
    srcs = ["ut_simple.cpp"],
    deps = ["@googletest//:gtest_main"],
)

# The Cyphal/UDP transport, publisher and subscriber against the host network stack.
forge_cc_test(
    name = "ut-cyphal",
    srcs = [
        "ut_publisher.cpp",
        "ut_serialization.cpp",
        "ut_subscriber.cpp",
        "ut_udp_frame.cpp",
    ],
    deps = [
        "//firmware:microcyphal",
        "@forge//firmware/native:ftl-native",
        "@googletest//:gtest_main",
    ],
)

[
    forge_cc_binary(
        name = name,
        srcs = [name.replace("-", "_") + ".cpp"],
        deps = [
            "//firmware:microcyphal",
            "@forge//firmware/native:ftl-native",
        ],
    )
    for name in [
        "hello-publisher",
        "hello-subscriber",
    ]
]
