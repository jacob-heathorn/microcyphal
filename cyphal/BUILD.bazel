load("@forge//bazel:cc.bzl", "forge_cc_library", "forge_cc_test")
load("//bazel:dsdl.bzl", "dsdl_cc_library")

package(default_visibility = ["//visibility:public"])

# C++ types for the uavcan DSDL namespace, generated by nunavut.
dsdl_cc_library(
    name = "uavcan",
    namespace = "@public_regulated_data_types//:uavcan",
    root = "uavcan",
)

# The header-only Cyphal/UDP stack.
forge_cc_library(
    name = "cyphal",
    hdrs = glob(["*.hpp"]),
    deps = [
        ":uavcan",
        "@forge//forge/ftl",
    ],
)

# The transport, publisher and subscriber against the host network stack.
forge_cc_test(
    name = "cyphal_test",
    srcs = [
        "serialization_test.cpp",
        "udp_frame_test.cpp",
        "udp_publisher_test.cpp",
        "udp_subscriber_test.cpp",
    ],
    deps = [
        ":cyphal",
        "@forge//forge/native",
        "@googletest//:gtest_main",
    ],
)
