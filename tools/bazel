#!/usr/bin/env bash
# Bazelisk runs this in place of bazel: point bzlmod at the gordion checkouts in this workspace.
set -euo pipefail
mkdir -p "$(dirname "$0")/../.bazel"
gordion bazelrc > "$(dirname "$0")/../.bazel/gordion.bazelrc"
exec "${BAZEL_REAL:?tools/bazel is run by bazelisk, not directly}" "$@"
