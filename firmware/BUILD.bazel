load("@forge//bazel:cc.bzl", "forge_cc_library")
load("//bazel:dsdl.bzl", "dsdl_cc_library")

# C++ types for the uavcan DSDL namespace, generated by nunavut.
dsdl_cc_library(
    name = "uavcan",
    namespace = "@public_regulated_data_types//:uavcan",
    root = "uavcan",
    visibility = ["//visibility:public"],
)

# The header-only Cyphal/UDP stack.
forge_cc_library(
    name = "microcyphal",
    hdrs = glob(["include/cyphal/*.hpp"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":uavcan",
        "@forge//firmware/ftl",
    ],
)
